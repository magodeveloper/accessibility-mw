{
  "files": [
    {
      "path": "./dist/server.js",
      "maxSize": "5mb",
      "compression": "none"
    },
    {
      "path": "./dist/routes/analyze.route.js",
      "maxSize": "2mb",
      "compression": "none"
    },
    {
      "path": "./dist/utils/security.js",
      "maxSize": "1mb",
      "compression": "none"
    }
  ],
  "ci": {
    "trackBranches": ["main", "master", "develop"],
    "compareWith": "main",
    "repoBranchBase": "origin/main"
  },
  "defaultCompression": "none",
  "normalizeFilenames": "^.*\\/"
}
