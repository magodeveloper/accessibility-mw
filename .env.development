##############################################################
# ACCESSIBILITY MIDDLEWARE - DEVELOPMENT CONFIGURATION
##############################################################

##############################################################
# CONFIGURACIÓN DEL SERVIDOR
##############################################################
NODE_ENV=development
APP_ENV=DEV
PORT=3001
# HOST puede ser localhost para desarrollo local o 0.0.0.0 para Docker
HOST=localhost
TRUST_PROXY=false
# Lista de orígenes permitidos para CORS (frontend local)
CORS_ORIGINS=http://localhost:3000

##############################################################
# CONFIGURACIÓN DOCKER COMPOSE
##############################################################
# Puerto del host para el middleware
MW_HOST_PORT=3001
# Tamaño del heap de Node.js (en MB)
NODE_HEAP_SIZE=2048
# Memoria compartida (para Playwright)
SHM_SIZE=1g
# Límite de memoria del contenedor
MEMORY_LIMIT=4G
# Límite de archivos abiertos
ULIMIT_NOFILE=32768
# Configuración de health checks
HEALTH_INTERVAL=15s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=2
HEALTH_START_PERIOD=20s
# Configuración de logging
LOG_MAX_SIZE=5m
LOG_MAX_FILES=2
# Configuración de tmpfs
TMPFS_LOGS_SIZE=50m
TMPFS_CACHE_SIZE=128m
TMPFS_TMP_SIZE=256m

##############################################################
# AUTENTICACIÓN Y SEGURIDAD JWT
##############################################################
# IMPORTANTE: Estos valores deben coincidir con los microservicios .NET
# ℹ️  JWT disponible para otras rutas protegidas (NO se usa en /api/analyze que son públicas)
# Secret Key para firmar tokens JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=ciuccAsOCXDRlvOg/79UUaitwkZ7Zf6MInGmwhDYo3ao4YfDgkAs+a0c3d7O5XbL
# Emisor del token (debe coincidir con microservicios)
JWT_ISSUER=https://api.accessibility.company.com/middleware
# Audiencia del token (debe coincidir con microservicios)
JWT_AUDIENCE=https://accessibility.company.com
# Tiempo de expiración en horas
JWT_EXPIRY_HOURS=24
# Tolerancia de reloj en segundos (0 = sin tolerancia)
JWT_CLOCK_TOLERANCE=0

##############################################################
# VALIDACIÓN DE GATEWAY SECRET
##############################################################
# IMPORTANTE: Este secret debe coincidir con el configurado en el Gateway
# 🔒 HABILITADO para asegurar que las peticiones vienen del Gateway
# Secret compartido para validar que las peticiones vienen del Gateway (mínimo 32 caracteres)
GATEWAY_SECRET=yqkAjpnBhLdfgTebwozrl2xOX8Nms3PU6JWFIV9vHuiZ1YMS
# Habilitado para validación del Gateway (las rutas /api/analyze son públicas pero DEBEN venir del Gateway)
GATEWAY_VALIDATION_ENABLED=true

##############################################################
# SERVICIOS EXTERNOS
##############################################################
# URL del microservicio de análisis para guardar resultados
# Usar localhost para desarrollo local
# Usar host.docker.internal:8082 para Docker en Windows/Mac
# Usar IP del host para Docker en Linux
ANALYSIS_API_URL=http://localhost:8082

##############################################################
# CONFIGURACIÓN DE PLAYWRIGHT
##############################################################
PLAYWRIGHT_HEADLESS=true

##############################################################
# CONFIGURACIÓN DE SEGURIDAD (SOLO DESARROLLO)
##############################################################
BYPASS_SSRF_VALIDATION_IN_DEV=true
ALLOW_PRIVATE_IPS_IN_DEV=true
ALLOW_LOOPBACK_IN_DEV=true
RELAX_TLS_IN_DEV=true

##############################################################
# CONFIGURACIÓN DE BROWSER POOL
##############################################################
BROWSER_POOL_MAX_SIZE=2
BROWSER_POOL_MAX_IDLE_MS=180000

##############################################################
# CONFIGURACIÓN DE CACHE
##############################################################
CACHE_MAX_ENTRIES=50
CACHE_MAX_MEMORY_MB=25
CACHE_DEFAULT_TTL_MINUTES=15

##############################################################
# LÍMITES Y TIEMPOS (EN MILISEGUNDOS)
##############################################################
MAX_HTML_BYTES=300000
URL_LENGTH_LIMIT=4096
REDIRECT_LIMIT=3
RESPONSE_BYTES_LIMIT=2000000
REQUEST_TIMEOUT_MS=20000
SOCKET_TIMEOUT_MS=30000
ANALYZE_TIMEOUT_MS=60000
NAVIGATION_TIMEOUT_MS=30000
IDLE_WAIT_MS=3000
HEALTHCHECK_TIMEOUT_MS=20000

##############################################################
# PUERTOS PERMITIDOS
##############################################################
ALLOWED_PORTS=80,443,3000,3001,8082

##############################################################
# LÍMITES DE PETICIONES (RATE LIMITING)
##############################################################
RATE_WINDOW_MS=60000          # 1 min
RATE_MAX=200                  # Más alto para no bloquear pruebas en desarrollo
RATE_ANALYZE_WINDOW_MS=60000  # 1 min
RATE_ANALYZE_MAX=100          # Más alto para desarrollo

##############################################################
# HEALTH MONITORING Y ALERTAS (DESHABILITADO EN DESARROLLO)
##############################################################
HEALTH_ALERTS_ENABLED=false
HEALTH_WEBHOOK_URL=
HEALTH_SLACK_WEBHOOK=
HEALTH_ALERT_COOLDOWN_MS=300000
HEALTH_DEBUG=true
