##############################################################
# ACCESSIBILITY MIDDLEWARE - PRODUCTION CONFIGURATION
##############################################################

##############################################################
# CONFIGURACIÓN DEL SERVIDOR
##############################################################
NODE_ENV=production
APP_ENV=PROD
PORT=3001
# HOST debe ser 0.0.0.0 para producción (Docker/Kubernetes)
HOST=0.0.0.0
TRUST_PROXY=true
# Lista de orígenes permitidos para CORS (dominio de producción)
CORS_ORIGINS=https://yourdomain.com

##############################################################
# CONFIGURACIÓN DOCKER COMPOSE
##############################################################
# Puerto del host para el middleware
MW_HOST_PORT=3001
# Tamaño del heap de Node.js (en MB)
NODE_HEAP_SIZE=2048
# Memoria compartida (para Playwright)
SHM_SIZE=2g
# Límite de memoria del contenedor
MEMORY_LIMIT=3G
# Límite de archivos abiertos
ULIMIT_NOFILE=65536
# Configuración de health checks
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=10s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=20s
# Configuración de logging
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
# Configuración de tmpfs
TMPFS_LOGS_SIZE=100m
TMPFS_CACHE_SIZE=256m
TMPFS_TMP_SIZE=512m

##############################################################
# AUTENTICACIÓN Y SEGURIDAD JWT
##############################################################
# IMPORTANTE: Estos valores deben coincidir con los microservicios .NET
# Secret Key para firmar tokens JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=9b3e7ER@S^glvxPWKX8nN?DTqtrd%Yj!oVIfh+BG&piHwZz6ky4Q52MumOFA-Lc0
# Emisor del token (debe coincidir con microservicios)
JWT_ISSUER=https://api.accessibility.company.com/middleware
# Audiencia del token (debe coincidir con microservicios)
JWT_AUDIENCE=https://accessibility.company.com
# Tiempo de expiración en horas
JWT_EXPIRY_HOURS=24
# Tolerancia de reloj en segundos (0 = sin tolerancia)
JWT_CLOCK_TOLERANCE=0

##############################################################
# VALIDACIÓN DE GATEWAY SECRET
##############################################################
# IMPORTANTE: Este secret debe coincidir con el configurado en el Gateway
# Secret compartido para validar que las peticiones vienen del Gateway (mínimo 32 caracteres)
GATEWAY_SECRET=Xk8@m2Pq!wR7vN#zL4tF9bH5sD3cA6eG1jY0uI8oT2nM7xW4vB6hK9fE5pQ3sZ1r
# CRÍTICO: SIEMPRE habilitado en producción para prevenir bypass del Gateway
GATEWAY_VALIDATION_ENABLED=true

##############################################################
# SERVICIOS EXTERNOS
##############################################################
# URL del microservicio de análisis para guardar resultados
# En producción usar el nombre del servicio interno o IP
ANALYSIS_API_URL=http://host.docker.internal:8082

##############################################################
# CONFIGURACIÓN DE PLAYWRIGHT
##############################################################
PLAYWRIGHT_HEADLESS=true

##############################################################
# CONFIGURACIÓN DE SEGURIDAD (PRODUCCIÓN)
##############################################################
# Todas las validaciones de seguridad habilitadas en producción
BYPASS_SSRF_VALIDATION_IN_DEV=false
ALLOW_PRIVATE_IPS_IN_DEV=false
ALLOW_LOOPBACK_IN_DEV=false
RELAX_TLS_IN_DEV=false

##############################################################
# CONFIGURACIÓN DE BROWSER POOL
##############################################################
BROWSER_POOL_MAX_SIZE=5
BROWSER_POOL_MAX_IDLE_MS=600000

##############################################################
# CONFIGURACIÓN DE CACHE
##############################################################
CACHE_MAX_ENTRIES=200
CACHE_MAX_MEMORY_MB=100
CACHE_DEFAULT_TTL_MINUTES=60

##############################################################
# LÍMITES Y TIEMPOS (EN MILISEGUNDOS)
##############################################################
MAX_HTML_BYTES=300000
URL_LENGTH_LIMIT=4096
REDIRECT_LIMIT=3
RESPONSE_BYTES_LIMIT=2000000
REQUEST_TIMEOUT_MS=15000
SOCKET_TIMEOUT_MS=25000
ANALYZE_TIMEOUT_MS=45000
NAVIGATION_TIMEOUT_MS=25000
IDLE_WAIT_MS=2000
HEALTHCHECK_TIMEOUT_MS=15000

##############################################################
# PUERTOS PERMITIDOS
##############################################################
ALLOWED_PORTS=80,443

##############################################################
# LÍMITES DE PETICIONES (RATE LIMITING)
##############################################################
RATE_WINDOW_MS=60000          # 1 min
RATE_MAX=60                   # Límite normal para producción
RATE_ANALYZE_WINDOW_MS=60000  # 1 min
RATE_ANALYZE_MAX=20           # Límite conservador para análisis

##############################################################
# HEALTH MONITORING Y ALERTAS
##############################################################
HEALTH_ALERTS_ENABLED=true
HEALTH_WEBHOOK_URL=
HEALTH_SLACK_WEBHOOK=
HEALTH_ALERT_COOLDOWN_MS=300000
HEALTH_DEBUG=false
