##############################################################
# ACCESSIBILITY MIDDLEWARE - PRODUCTION CONFIGURATION
##############################################################
# ⚠️  IMPORTANTE - SEGURIDAD:
# 1. Este archivo contiene configuración de producción
# 2. NUNCA commitear este archivo al repositorio
# 3. Cambiar TODOS los secretos antes de desplegar
# 4. Usar secretos de al menos 64 caracteres
# 5. Generar secretos con: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
##############################################################

##############################################################
# CONFIGURACIÓN DEL SERVIDOR
##############################################################
NODE_ENV=production
APP_ENV=PROD
PORT=3001
# HOST debe ser 0.0.0.0 para producción (Docker/Kubernetes)
HOST=0.0.0.0
TRUST_PROXY=true
# Lista de orígenes permitidos para CORS (dominio de producción)
CORS_ORIGINS=https://yourdomain.com

##############################################################
# CONFIGURACIÓN DOCKER COMPOSE
##############################################################
# Puerto del host para el middleware
MW_HOST_PORT=3001

# Tamaño del heap de Node.js (en MB) - Ajustar según recursos disponibles
NODE_HEAP_SIZE=2048

# Memoria compartida (para Playwright) - Mínimo 2GB recomendado
SHM_SIZE=2g

# Límite de memoria del contenedor - Ajustar según carga esperada
MEMORY_LIMIT=3G
MEMORY_RESERVATION=2G

# Límite de CPU (1.0 = 1 core, 2.0 = 2 cores)
CPU_LIMIT=2.0
CPU_RESERVATION=1.0

# Límite de archivos abiertos
ULIMIT_NOFILE=65536

# Configuración de health checks
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=10s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=30s

# Configuración de logging
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Configuración de tmpfs (RAM disk para mejor performance)
TMPFS_LOGS_SIZE=100m
TMPFS_CACHE_SIZE=256m
TMPFS_TMP_SIZE=512m
TMPFS_TEMP_SIZE=256m

# Configuración de red
NETWORK_MTU=1500
SUBNET=172.22.0.0/16
GATEWAY=172.22.0.1

# Build metadata (para CI/CD)
VERSION=1.0.0
BUILD_DATE=
VCS_REF=

# Ruta para volúmenes de logs (opcional)
LOGS_PATH=./logs

##############################################################
# AUTENTICACIÓN Y SEGURIDAD JWT
##############################################################
# IMPORTANTE: Estos valores deben coincidir con los microservicios .NET
# Secret Key para firmar tokens JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=9b3e7ER@S^glvxPWKX8nN?DTqtrd%Yj!oVIfh+BG&piHwZz6ky4Q52MumOFA-Lc0
# Emisor del token (debe coincidir con microservicios)
JWT_ISSUER=https://api.accessibility.company.com/middleware
# Audiencia del token (debe coincidir con microservicios)
JWT_AUDIENCE=https://accessibility.company.com
# Tiempo de expiración en horas
JWT_EXPIRY_HOURS=24
# Tolerancia de reloj en segundos (0 = sin tolerancia)
JWT_CLOCK_TOLERANCE=0

##############################################################
# VALIDACIÓN DE GATEWAY SECRET
##############################################################
# IMPORTANTE: Este secret debe coincidir con el configurado en el Gateway
# Secret compartido para validar que las peticiones vienen del Gateway (mínimo 32 caracteres)
GATEWAY_SECRET=VGhpc0lzQVNlY3JldEtleUZvckdhdGV3YXkyMDI0
# CRÍTICO: SIEMPRE habilitado en producción para prevenir bypass del Gateway
GATEWAY_VALIDATION_ENABLED=true

##############################################################
# SERVICIOS EXTERNOS
##############################################################
# URL del microservicio de análisis para guardar resultados
# ⚠️  PRODUCCIÓN: Ajustar según tu infraestructura
# - Docker Compose: http://host.docker.internal:8082
# - Kubernetes: http://ms-analysis-service:8082
# - Cloud: https://analysis-api.yourdomain.com
ANALYSIS_API_URL=http://host.docker.internal:8082

# URL del microservicio de reportes (opcional)
# REPORTS_API_URL=http://host.docker.internal:8083

##############################################################
# CONFIGURACIÓN DE PLAYWRIGHT
##############################################################
PLAYWRIGHT_HEADLESS=true

##############################################################
# CONFIGURACIÓN DE SEGURIDAD (PRODUCCIÓN)
##############################################################
# Todas las validaciones de seguridad habilitadas en producción
BYPASS_SSRF_VALIDATION_IN_DEV=false
ALLOW_PRIVATE_IPS_IN_DEV=false
ALLOW_LOOPBACK_IN_DEV=false
RELAX_TLS_IN_DEV=false

##############################################################
# CONFIGURACIÓN DE BROWSER POOL
##############################################################
# Tamaño máximo del pool de navegadores (ajustar según carga)
BROWSER_POOL_MAX_SIZE=5
# Tiempo máximo que un navegador puede estar inactivo (ms)
BROWSER_POOL_MAX_IDLE_MS=600000

##############################################################
# CONFIGURACIÓN DE CACHE
##############################################################
# Número máximo de entradas en cache
CACHE_MAX_ENTRIES=200
# Memoria máxima del cache en MB
CACHE_MAX_MEMORY_MB=100
# TTL por defecto del cache en minutos
CACHE_DEFAULT_TTL_MINUTES=60

##############################################################
# CONFIGURACIÓN DE PERFORMANCE
##############################################################
# Timeout de análisis en milisegundos
ANALYZE_TIMEOUT_MS=25000
# Timeout de navegación en milisegundos
NAVIGATION_TIMEOUT_MS=12000
# Timeout de request HTTP en milisegundos
REQUEST_TIMEOUT_MS=20000

##############################################################
# RATE LIMITING
##############################################################
# Ventana de tiempo para rate limiting (ms)
RATE_LIMIT_WINDOW_MS=60000
# Máximo de requests generales por ventana
RATE_LIMIT_MAX_REQUESTS=50
# Máximo de requests de análisis por ventana
ANALYZE_RATE_LIMIT_MAX=10

##############################################################
# LÍMITES Y TIEMPOS (EN MILISEGUNDOS)
##############################################################
MAX_HTML_BYTES=300000
URL_LENGTH_LIMIT=4096
REDIRECT_LIMIT=3
RESPONSE_BYTES_LIMIT=2000000
REQUEST_TIMEOUT_MS=15000
SOCKET_TIMEOUT_MS=25000
ANALYZE_TIMEOUT_MS=45000
NAVIGATION_TIMEOUT_MS=25000
IDLE_WAIT_MS=2000
HEALTHCHECK_TIMEOUT_MS=15000

##############################################################
# PUERTOS PERMITIDOS
##############################################################
ALLOWED_PORTS=80,443

##############################################################
# LÍMITES DE PETICIONES (RATE LIMITING)
##############################################################
RATE_WINDOW_MS=60000          # 1 min
RATE_MAX=60                   # Límite normal para producción
RATE_ANALYZE_WINDOW_MS=60000  # 1 min
RATE_ANALYZE_MAX=20           # Límite conservador para análisis

##############################################################
# HEALTH MONITORING Y ALERTAS
##############################################################
HEALTH_ALERTS_ENABLED=true
HEALTH_WEBHOOK_URL=
HEALTH_SLACK_WEBHOOK=
HEALTH_ALERT_COOLDOWN_MS=300000
HEALTH_DEBUG=false
