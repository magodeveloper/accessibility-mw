##############################################################
# ACCESSIBILITY MIDDLEWARE - ENVIRONMENT TEMPLATE
##############################################################
# Copia este archivo a .env y ajusta los valores según tu entorno
# O usa directamente .env.development o .env.production

##############################################################
# CONFIGURACIÓN DEL SERVIDOR
##############################################################
NODE_ENV=development                    # development | production
APP_ENV=DEV                            # DEV | PROD
PORT=3001
HOST=localhost                         # localhost para local, 0.0.0.0 para Docker
TRUST_PROXY=false                      # false para desarrollo, true para producción

##############################################################
# AUTENTICACIÓN Y SEGURIDAD JWT
##############################################################
# IMPORTANTE: Estos valores deben coincidir con los microservicios .NET
# Secret Key para firmar tokens JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=9b3e7ER@S^glvxPWKX8nN?DTqtrd%Yj!oVIfh+BG&piHwZz6ky4Q52MumOFA-Lc0
# Emisor del token (debe coincidir con microservicios)
JWT_ISSUER=https://api.accessibility.company.com/middleware
# Audiencia del token (debe coincidir con microservicios)
JWT_AUDIENCE=https://accessibility.company.com
# Tiempo de expiración en horas
JWT_EXPIRY_HOURS=24
# Tolerancia de reloj en segundos (0 = sin tolerancia)
JWT_CLOCK_TOLERANCE=0

##############################################################
# VALIDACIÓN DE GATEWAY SECRET
##############################################################
# IMPORTANTE: Este secret debe coincidir con el configurado en el Gateway
# Secret compartido para validar que las peticiones vienen del Gateway (mínimo 32 caracteres)
GATEWAY_SECRET=Xk8@m2Pq!wR7vN#zL4tF9bH5sD3cA6eG1jY0uI8oT2nM7xW4vB6hK9fE5pQ3sZ1r
# Habilitar/deshabilitar validación del Gateway Secret (true = producción, false = desarrollo)
GATEWAY_VALIDATION_ENABLED=true

##############################################################
# SERVICIOS EXTERNOS
##############################################################
# URL del microservicio de análisis para guardar resultados
ANALYSIS_API_URL=http://localhost:8082        # Local: localhost:8082, Docker: host.docker.internal:8082
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000            # Frontend URL

##############################################################
# CONFIGURACIÓN DE PLAYWRIGHT
##############################################################
PLAYWRIGHT_HEADLESS=true

##############################################################
# CONFIGURACIÓN DE SEGURIDAD (SOLO DESARROLLO)
##############################################################
BYPASS_SSRF_VALIDATION_IN_DEV=true
ALLOW_PRIVATE_IPS_IN_DEV=true
ALLOW_LOOPBACK_IN_DEV=true
RELAX_TLS_IN_DEV=true

##############################################################
# LÍMITES Y TIEMPOS (EN MILISEGUNDOS)
##############################################################
MAX_HTML_BYTES=300000
URL_LENGTH_LIMIT=4096
REDIRECT_LIMIT=3
RESPONSE_BYTES_LIMIT=2000000
REQUEST_TIMEOUT_MS=20000
SOCKET_TIMEOUT_MS=30000
ANALYZE_TIMEOUT_MS=60000
NAVIGATION_TIMEOUT_MS=30000
IDLE_WAIT_MS=3000
HEALTHCHECK_TIMEOUT_MS=15000

##############################################################
# CONFIGURACIÓN DE BROWSER POOL
##############################################################
BROWSER_POOL_MAX_SIZE=3                       # 2 para desarrollo, 5 para producción
BROWSER_POOL_MAX_IDLE_MS=300000               # Tiempo en ms antes de cerrar browsers inactivos

##############################################################
# CONFIGURACIÓN DE CACHE
##############################################################
CACHE_MAX_ENTRIES=100                         # 50 para desarrollo, 200 para producción
CACHE_MAX_MEMORY_MB=50                        # 25 para desarrollo, 100 para producción
CACHE_DEFAULT_TTL_MINUTES=30                  # 15 para desarrollo, 60 para producción

##############################################################
# PUERTOS PERMITIDOS
##############################################################
ALLOWED_PORTS=80,443,3000,3001,8082          # Puertos permitidos para requests

##############################################################
# LÍMITES DE PETICIONES (RATE LIMITING)
##############################################################
RATE_WINDOW_MS=60000                          # Ventana de tiempo para rate limiting
RATE_MAX=60                                   # Requests máximos por ventana (200 para dev)
RATE_ANALYZE_WINDOW_MS=60000                  # Ventana específica para análisis
RATE_ANALYZE_MAX=20                           # Análisis máximos por ventana (100 para dev)

##############################################################
# HEALTH MONITORING Y ALERTAS
##############################################################
HEALTH_ALERTS_ENABLED=false                   # true para producción
HEALTH_WEBHOOK_URL=                           # URL para webhooks de alertas
HEALTH_SLACK_WEBHOOK=                         # URL de Slack para alertas
HEALTH_ALERT_COOLDOWN_MS=300000               # Tiempo entre alertas (5 min)
HEALTH_DEBUG=false                            # true para desarrollo
