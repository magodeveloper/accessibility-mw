# =============================================================================
# Variables de entorno para Middleware Node.js - PLANTILLA
# =============================================================================
# IMPORTANTE: Este es un archivo de ejemplo. Copie este archivo a:
#   - .env.development (para entorno de desarrollo local)
#   - .env.production (para entorno de producción)
# y ajuste los valores según su entorno específico.
#
# ADVERTENCIA DE SEGURIDAD:
# - NO commitear archivos .env.development o .env.production al repositorio
# - Cambiar TODAS las contraseñas y secretos antes de usar en producción
# - Los secretos JWT y Gateway deben ser únicos y seguros (mínimo 64 caracteres)
# - Generar secretos seguros con: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# =============================================================================

# --- ENTORNO ---
# Valores: development, production
NODE_ENV=development

# --- CONFIGURACIÓN DEL SERVIDOR ---
# Puerto en el que se ejecutará el middleware
PORT=3001
# Host: localhost para desarrollo local, 0.0.0.0 para Docker
HOST=localhost
# Entorno de aplicación: DEV para desarrollo, PROD para producción
APP_ENV=DEV
# Trust proxy: false para desarrollo, true para producción con proxy inverso
TRUST_PROXY=false

# --- AUTENTICACIÓN Y SEGURIDAD JWT ---
# IMPORTANTE: Estos valores deben coincidir con los microservicios .NET
# Secret Key para firmar tokens JWT (CAMBIAR en producción - mínimo 64 caracteres)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_KEY_IN_PRODUCTION_MIN_64_CHARS
# Emisor del token (debe coincidir con configuración de microservicios)
JWT_ISSUER=https://api.accessibility.company.com/middleware
# Audiencia del token (debe coincidir con configuración de microservicios)
JWT_AUDIENCE=https://accessibility.company.com
# Tiempo de expiración en horas
JWT_EXPIRY_HOURS=24
# Tolerancia de reloj en segundos (0 = sin tolerancia)
JWT_CLOCK_TOLERANCE=0

# --- VALIDACIÓN DE GATEWAY SECRET ---
# IMPORTANTE: Este secret debe coincidir con el configurado en el Gateway
# Secret compartido para validar peticiones del Gateway (CAMBIAR en producción - mínimo 64 caracteres)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
GATEWAY_SECRET=CHANGE_THIS_GATEWAY_SECRET_IN_PRODUCTION_MIN_64_CHARS
# Habilitar/deshabilitar validación del Gateway Secret
# true = producción (requerido), false = desarrollo (opcional)
GATEWAY_VALIDATION_ENABLED=false

# --- SERVICIOS EXTERNOS ---
# URL del microservicio de análisis para guardar resultados
# Desarrollo local: http://localhost:8082
# Docker: http://host.docker.internal:8082
# Producción: URL del servicio real
ANALYSIS_API_URL=http://localhost:8082
# Orígenes permitidos para CORS (separados por coma)
# Ejemplo: http://localhost:3000,https://app.production.com
CORS_ORIGINS=http://localhost:3000

# --- CONFIGURACIÓN DE ACCESSIBILITY TOOLS ---
# Habilitar Equal Access para análisis completo de accesibilidad
# "true" = usar Equal Access y axe-core, "false" = usar solo axe-core
ENABLE_EQUAL_ACCESS=true

# --- CONFIGURACIÓN DE PLAYWRIGHT ---
# Modo headless: true para producción, false para debugging
PLAYWRIGHT_HEADLESS=true

# --- CONFIGURACIÓN DE SEGURIDAD (SOLO DESARROLLO) ---
# ADVERTENCIA: Estas opciones deben estar en FALSE en producción
# Bypass de validación SSRF en desarrollo
BYPASS_SSRF_VALIDATION_IN_DEV=false
# Permitir IPs privadas en desarrollo
ALLOW_PRIVATE_IPS_IN_DEV=false
# Permitir loopback (localhost) en desarrollo
ALLOW_LOOPBACK_IN_DEV=false
# Relajar validación TLS en desarrollo
RELAX_TLS_IN_DEV=false

# --- LÍMITES Y TIEMPOS (EN MILISEGUNDOS) ---
# Tamaño máximo de HTML en bytes
MAX_HTML_BYTES=300000
# Longitud máxima de URL
URL_LENGTH_LIMIT=4096
# Límite de redirects permitidos
REDIRECT_LIMIT=3
# Límite de bytes en respuesta
RESPONSE_BYTES_LIMIT=2000000
# Timeout de request HTTP
REQUEST_TIMEOUT_MS=20000
# Timeout de socket
SOCKET_TIMEOUT_MS=30000
# Timeout de análisis de accesibilidad
ANALYZE_TIMEOUT_MS=60000
# Timeout de navegación en Playwright
NAVIGATION_TIMEOUT_MS=30000
# Tiempo de espera idle en navegador
IDLE_WAIT_MS=3000
# Timeout de health checks
HEALTHCHECK_TIMEOUT_MS=15000

# --- CONFIGURACIÓN DE BROWSER POOL ---
# Tamaño máximo del pool de navegadores (2-3 para desarrollo, 5-10 para producción)
BROWSER_POOL_MAX_SIZE=2
# Tiempo máximo de inactividad antes de cerrar un navegador (en ms)
BROWSER_POOL_MAX_IDLE_MS=300000

# --- CONFIGURACIÓN DE CACHE ---
# Máximo de entradas en cache (50 para desarrollo, 200 para producción)
CACHE_MAX_ENTRIES=50
# Límite de memoria para cache en MB (25 para desarrollo, 100 para producción)
CACHE_MAX_MEMORY_MB=25
# TTL por defecto en minutos (15 para desarrollo, 60 para producción)
CACHE_DEFAULT_TTL_MINUTES=15

# --- PUERTOS PERMITIDOS ---
# Lista de puertos permitidos para requests externos (separados por coma)
ALLOWED_PORTS=80,443,3000,3001,8082

# --- LÍMITES DE PETICIONES (RATE LIMITING) ---
# Ventana de tiempo para rate limiting general (en ms)
RATE_WINDOW_MS=60000
# Requests máximos por ventana general (100-200 para desarrollo, 60-100 para producción)
RATE_MAX=100
# Ventana de tiempo para rate limiting de análisis (en ms)
RATE_ANALYZE_WINDOW_MS=60000
# Análisis máximos por ventana (50 para desarrollo, 20 para producción)
RATE_ANALYZE_MAX=20

# --- HEALTH MONITORING Y ALERTAS ---
# Habilitar alertas de health checks (false para desarrollo, true para producción)
HEALTH_ALERTS_ENABLED=false
# URL para webhooks de alertas (opcional)
HEALTH_WEBHOOK_URL=
# URL de Slack para alertas (opcional)
HEALTH_SLACK_WEBHOOK=
# Tiempo mínimo entre alertas en ms (5 minutos = 300000)
HEALTH_ALERT_COOLDOWN_MS=300000
# Modo debug de health checks (true para desarrollo, false para producción)
HEALTH_DEBUG=false
