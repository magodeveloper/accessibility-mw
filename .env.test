# ═══════════════════════════════════════════════════════════════════════════
# Configuración de Tests - Variables de Entorno
# ═══════════════════════════════════════════════════════════════════════════

# 🐳 USAR SERVICIOS EXISTENTES
# ───────────────────────────────────────────────────────────────────────────
# En desarrollo local, usar servicios de microservicios ya corriendo
# Esto evita conflictos de puertos con docker-compose.ci.yml
USE_EXISTING_SERVICES=true

# 🌐 URLs DE MICROSERVICIOS
# ───────────────────────────────────────────────────────────────────────────
ANALYSIS_API_URL=http://localhost:8082
REPORTS_API_URL=http://localhost:8083
USERS_API_URL=http://localhost:8081

# ⏱️ TIMEOUTS
# ───────────────────────────────────────────────────────────────────────────
JEST_TIMEOUT_LOCAL=30000

# 🌐 SERVER CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
PORT=3001
HOST=localhost

# 🔐 GATEWAY SECRET
# ───────────────────────────────────────────────────────────────────────────
# Secret compartido entre microservicios para validar que las peticiones
# vienen del Gateway. Debe coincidir con Gateway.Secret en appsettings.Development.json
GATEWAY_SECRET=yqkAjpnBhLdfgTebwozrl2xOX8Nms3PU6JWFIV9vHuiZ1YMS
