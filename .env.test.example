# ═══════════════════════════════════════════════════════════════════════════
# Configuración de Tests - Variables de Entorno
# ═══════════════════════════════════════════════════════════════════════════
# Este archivo muestra TODAS las variables de entorno disponibles para
# configurar el comportamiento de los tests en tests/setup.ts
#
# Para usar: copiar a .env.test y descomentar/modificar según necesidad
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# 🔢 LISTENERS DE EVENTEMITTER
# ───────────────────────────────────────────────────────────────────────────
# Número máximo de listeners para evitar warnings con alta concurrencia

# MAX_LISTENERS_CI=30          # Default para CI
# MAX_LISTENERS_LOCAL=20        # Default para desarrollo local

# ───────────────────────────────────────────────────────────────────────────
# ⏱️ TIMEOUTS DE JEST
# ───────────────────────────────────────────────────────────────────────────
# Timeout global de Jest en milisegundos

# JEST_TIMEOUT_CI=60000         # 60 segundos en CI (default)
# JEST_TIMEOUT_LOCAL=30000      # 30 segundos en local (default)

# ───────────────────────────────────────────────────────────────────────────
# 🌐 URLs DE APIS
# ───────────────────────────────────────────────────────────────────────────
# URLs de los microservicios para tests de integración

# ANALYSIS_API_URL=http://localhost:8082    # Default
# REPORTS_API_URL=http://localhost:8083     # Default
# USERS_API_URL=http://localhost:8081       # Default

# Ejemplos para otros ambientes:
# ANALYSIS_API_URL=https://staging-analysis.example.com
# REPORTS_API_URL=https://staging-reports.example.com

# ───────────────────────────────────────────────────────────────────────────
# 🐳 CONFIGURACIÓN DE DOCKER
# ───────────────────────────────────────────────────────────────────────────
# Control de servicios Docker para tests de integración

# USE_EXISTING_SERVICES=true    # Usar servicios de desarrollo ya corriendo (recomendado)
                                # Si está en true, no levantará docker-compose.ci.yml
                                # Detectará automáticamente msanalysis-api, msreports-api, msusers-api
                                
# USE_EXISTING_SERVICES=false   # Levantar docker-compose.ci.yml (CI/CD)

# ───────────────────────────────────────────────────────────────────────────
# 🔐 GATEWAY SECRET
# ───────────────────────────────────────────────────────────────────────────
# Secret compartido para acceso directo a microservicios en tests de integración

# GATEWAY_SECRET=yqkAjpnBhLdfgTebwozrl2xOX8Nms3PU6JWFIV9vHuiZ1YMS  # Development secret
# Nota: Debe coincidir con Gateway.Secret configurado en appsettings.Development.json
#       de cada microservicio (Analysis, Reports, Users)

# ───────────────────────────────────────────────────────────────────────────
# 🤖 CONFIGURACIÓN DE PUPPETEER
# ───────────────────────────────────────────────────────────────────────────
# Argumentos de línea de comandos para Chromium

# PUPPETEER_ARGS=--no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding

# Ejemplo minimalista:
# PUPPETEER_ARGS=--no-sandbox --disable-gpu --headless=new

# ───────────────────────────────────────────────────────────────────────────
# 🎭 CONFIGURACIÓN DE PLAYWRIGHT
# ───────────────────────────────────────────────────────────────────────────
# Path donde Playwright almacena los navegadores

# PLAYWRIGHT_BROWSERS_PATH_CI=/home/runner/.cache/ms-playwright    # Default CI
# PLAYWRIGHT_BROWSERS_PATH_LOCAL=0                                  # Default local (0 = default path)

# Ejemplos personalizados:
# PLAYWRIGHT_BROWSERS_PATH_CI=/custom/cache/playwright
# PLAYWRIGHT_BROWSERS_PATH_LOCAL=/home/user/.playwright

# ───────────────────────────────────────────────────────────────────────────
# 💾 CONFIGURACIÓN DE MEMORIA NODE.JS
# ───────────────────────────────────────────────────────────────────────────
# Memoria máxima del heap de V8 en megabytes

# NODE_MAX_OLD_SPACE_SIZE=4096  # 4GB (default)

# Para tests complejos con mucha memoria:
# NODE_MAX_OLD_SPACE_SIZE=8192  # 8GB

# Para ambientes con recursos limitados:
# NODE_MAX_OLD_SPACE_SIZE=2048  # 2GB

# ───────────────────────────────────────────────────────────────────────────
# 📂 DIRECTORIOS DE CACHE
# ───────────────────────────────────────────────────────────────────────────
# Directorio de cache para achecker

# En CI (default): /tmp/.achecker_cache
# En Local (default): .achecker_cache

# ACHECKER_CACHE_DIR=/var/cache/achecker        # CI personalizado
# ACHECKER_CACHE_DIR=./cache/achecker           # Local personalizado

# ───────────────────────────────────────────────────────────────────────────
# 📝 SUPRESIÓN DE LOGS
# ───────────────────────────────────────────────────────────────────────────
# Controla qué logs se muestran durante los tests

# SUPPRESS_CI_LOGS=true         # Suprimir logs verbosos en CI
# CI=true                        # Detecta ambiente CI (auto-configurado en GitHub Actions)

# Patrones personalizados de logs a suprimir (JSON array):
# SUPPRESS_LOG_PATTERNS=["patron-1","patron-2","error-esperado"]

# ───────────────────────────────────────────────────────────────────────────
# 🔒 SEGURIDAD
# ───────────────────────────────────────────────────────────────────────────
# Validación SSRF (Server-Side Request Forgery)

# BYPASS_SSRF_VALIDATION_IN_DEV=true   # Default en local (permite más flexibilidad)
# BYPASS_SSRF_VALIDATION_IN_DEV=false  # Default en CI (más estricto)

# ───────────────────────────────────────────────────────────────────────────
# 📊 COVERAGE
# ───────────────────────────────────────────────────────────────────────────
# Instrumentación de coverage en contexto de browser

# DISABLE_BROWSER_COVERAGE=true    # Default en CI (evita conflictos)
# DISABLE_BROWSER_COVERAGE=false   # Default en local

# ═══════════════════════════════════════════════════════════════════════════
# EJEMPLOS DE CONFIGURACIONES COMPLETAS
# ═══════════════════════════════════════════════════════════════════════════

# ─── Desarrollo Local Básico ───
# (usar todos los defaults, no configurar nada)

# ─── Desarrollo Local con Timeouts Largos ───
# JEST_TIMEOUT_LOCAL=60000

# ─── CI con Configuración Personalizada ───
# CI=true
# MAX_LISTENERS_CI=40
# JEST_TIMEOUT_CI=90000
# NODE_MAX_OLD_SPACE_SIZE=6144
# SUPPRESS_CI_LOGS=true

# ─── Tests de Integración con Servicios Remotos ───
# ANALYSIS_API_URL=https://staging-analysis.example.com
# REPORTS_API_URL=https://staging-reports.example.com

# ─── CI con Logs Personalizados ───
# CI=true
# SUPPRESS_LOG_PATTERNS=["my-custom-warning","expected-error-pattern"]

# ═══════════════════════════════════════════════════════════════════════════
# NOTAS IMPORTANTES
# ═══════════════════════════════════════════════════════════════════════════
# 1. Todas las variables son OPCIONALES, tienen defaults sensatos
# 2. Los valores numéricos deben ser enteros (sin comillas)
# 3. Los valores booleanos deben ser 'true' o 'false' (con comillas)
# 4. SUPPRESS_LOG_PATTERNS debe ser un array JSON válido
# 5. En CI, muchas variables se auto-configuran automáticamente
# ═══════════════════════════════════════════════════════════════════════════
