# Dockerfile optimizado para desarrollo - Más ligero
# Usa Alpine en lugar de la imagen completa de Playwright

# Etapa 1: Build
FROM node:25.5.0-alpine3.22 AS builder

WORKDIR /app

# Instalar dependencias
RUN apk add --no-cache git chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV CHROMIUM_PATH=/usr/bin/chromium-browser

# Copiar package files
COPY package*.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

# Copiar código y compilar
COPY tsconfig*.json ./
COPY config ./config
COPY scripts ./scripts
COPY src ./src
RUN npm run build

# Etapa 2: Runtime (Alpine - mucho más ligera)
FROM node:25.5.0-alpine3.22

WORKDIR /app

# Instalar solo lo necesario para runtime
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont && \
    rm -rf /var/cache/apk/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV CHROMIUM_PATH=/usr/bin/chromium-browser
ENV NODE_ENV=production
ENV PORT=3001

# Copiar desde builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY .achecker.yml ./

# Crear directorios
RUN mkdir -p /app/results /app/logs /app/.achecker_cache/engine /app/temp && \
    chmod -R 755 /app

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/health', r => process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "dist/server.js"]

# Esta imagen es ~500MB vs ~3GB de la imagen con Playwright completo
