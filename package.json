  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/magodeveloper/accessibility-mw/issues"
  },
  "homepage": "https://github.com/magodeveloper/accessibility-mw#readme",
  "dependencies": {
    "accessibility-checker": "^4.0.7",
    "axe-core": "^4.10.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pino": "^9.8.0",
    "pino-http": "^10.5.0",
    "playwright": "^1.54.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.15",
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
