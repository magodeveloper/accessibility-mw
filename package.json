{
  "name": "accessibility-mw",
  "version": "1.0.0",
  "description": "Middleware de Accesibilidad - Análisis automático de sitios web",
  "keywords": [
    "accessibility",
    "middleware",
    "axe-core",
    "web-accessibility",
    "analysis",
    "automation"
  ],
  "license": "ISC",
  "author": "magodeveloper",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "bundle:check": "node scripts/check-bundle-limits.js",
    "bundle:full": "npm run build && npm run test:unit:coverage && npm run bundle:monitor",
    "bundle:monitor": "npm run build && node scripts/bundle-monitor.js",
    "clean": "rimraf dist",
    "copy-assets": "powershell -Command \"Copy-Item src/routes/*.yaml dist/routes/ -ErrorAction SilentlyContinue\" || cp src/routes/*.yaml dist/routes/ 2>/dev/null || true",
    "dev": "ts-node src/server.ts",
    "docker:build": "docker compose --env-file .env.development build --progress=plain",
    "docker:build:prod": "docker compose --env-file .env.production -f docker-compose.production.yml build --progress=plain --no-cache",
    "docker:down": "docker compose --env-file .env.development down",
    "docker:down:prod": "docker compose --env-file .env.production -f docker-compose.production.yml down",
    "docker:logs": "docker compose --env-file .env.development logs",
    "docker:logs:follow": "docker compose --env-file .env.development logs -f",
    "docker:logs:prod": "docker compose --env-file .env.production -f docker-compose.production.yml logs",
    "docker:logs:prod:follow": "docker compose --env-file .env.production -f docker-compose.production.yml logs -f",
    "docker:ps": "docker compose --env-file .env.development ps",
    "docker:ps:prod": "docker compose --env-file .env.production -f docker-compose.production.yml ps",
    "docker:restart": "docker compose --env-file .env.development restart",
    "docker:restart:prod": "docker compose --env-file .env.production -f docker-compose.production.yml restart",
    "docker:status": "docker compose --env-file .env.development ps",
    "docker:status:prod": "docker compose --env-file .env.production -f docker-compose.production.yml ps",
    "docker:up": "docker compose --env-file .env.development up -d",
    "docker:up:dev": "docker compose --env-file .env.development up",
    "docker:up:prod": "docker compose --env-file .env.production -f docker-compose.production.yml up -d",
    "docker:up:prod:attached": "docker compose --env-file .env.production -f docker-compose.production.yml up",
    "docker:up:rebuild": "docker compose --env-file .env.development up --build --progress=plain",
    "lint": "eslint src/**/*.ts",
    "lint:check": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "predeploy": "npm run validate:production && npm run build && npm run test:ci",
    "preview": "npm run build && npm start",
    "quality:check": "npm run lint:check && npm run type-check && npm run test:coverage",
    "sonar": "sonar-scanner",
    "sonar:check": "echo 'Checking SonarQube configuration...' && test -f sonar-project.properties && echo '✅ sonar-project.properties found' || echo '❌ Missing sonar-project.properties'",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:ci": "jest --config jest.ci.config.js --runInBand --forceExit",
    "test:contract": "jest --config jest.contract.config.js --forceExit --detectOpenHandles",
    "test:coverage": "jest --config jest.coverage.config.js --forceExit --detectOpenHandles",
    "test:e2e": "jest --testPathPatterns=e2e --coverageThreshold={} --forceExit --detectOpenHandles",
    "test:integration": "jest --config jest.integration.config.js --forceExit --runInBand",
    "test:unit": "jest --testPathPatterns=tests/unit --forceExit --detectOpenHandles",
    "test:unit:coverage": "jest --testPathPatterns=tests/unit --collectCoverage --coverageDirectory=coverage/unit --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "validate:env": "node -e \"require('dotenv').config({path:'.env.'+process.env.NODE_ENV});console.log('✅ Environment validated')\"",
    "validate:production": "node ./scripts/validate-production.js"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "accessibility-checker": "4.0.9",
    "axe-core": "4.11.0",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "ipaddr.js": "2.2.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "playwright": "^1.56.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@jest/globals": "^30.2.0",
    "@jest/test-sequencer": "^30.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-mock": "^30.2.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
