{
  "name": "accessibility-mw",
  "version": "1.0.0",
  "description": "Middleware de Accesibilidad - Análisis automático de sitios web",
  "keywords": [
    "accessibility",
    "middleware",
    "axe-core",
    "web-accessibility",
    "analysis",
    "automation"
  ],
  "license": "ISC",
  "author": "magodeveloper",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "clean": "rimraf dist",
    "copy-assets": "powershell -Command \"Copy-Item src/routes/*.yaml dist/routes/ -ErrorAction SilentlyContinue\" || cp src/routes/*.yaml dist/routes/ 2>/dev/null || true",
    "dev": "ts-node src/server.ts",
    "docker:build": "docker build -t accessibility-mw .",
    "docker:run": "docker run -p 3000:3000 accessibility-mw",
    "lint": "eslint src/**/*.ts",
    "lint:check": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "bundle:full": "npm run build && npm run test:coverage && npm run bundle:monitor",
    "bundle:monitor": "npm run build && node scripts/bundle-monitor.js",
    "bundle:check": "node scripts/check-bundle-limits.js",
    "start": "node dist/server.js",
    "test": "jest --detectOpenHandles",
    "test:ci": "jest --config jest.ci.config.js --detectOpenHandles",
    "test:coverage": "jest --config jest.coverage.config.js --detectOpenHandles",
    "test:integration": "jest --config jest.ci.config.js --testPathPatterns=integration --detectOpenHandles",
    "test:e2e": "jest --testPathPatterns=e2e --coverageThreshold={} --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "accessibility-checker": "4.0.9",
    "axe-core": "4.10.3",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "ipaddr.js": "2.2.0",
    "js-yaml": "^4.1.0",
    "pino": "9.9.5",
    "pino-http": "10.5.0",
    "playwright": "^1.55.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@jest/globals": "^30.1.2",
    "@jest/test-sequencer": "^30.1.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.4.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
