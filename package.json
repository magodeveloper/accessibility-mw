{
  "name": "accessibility-mw",
  "version": "1.0.0",
  "description": "accessibility-mw",
  "main": "server.js",
  "scripts": {
    "build": "tsc && pwsh -Command \"Copy-Item src/routes/*.yaml dist/routes/ -Force\"",
    "build:check": "tsc --noEmit --incremental",
    "type-check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "dev:debug": "node --inspect-brk --import tsx src/server.ts",
    "dev:debug:watch": "node --inspect-brk --import tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:debug": "node --inspect-brk dist/server.js",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "test": "cross-env ANALYSIS_API_URL=http://localhost:8082 jest --testTimeout=30000",
    "test:unit": "cross-env ANALYSIS_API_URL=http://localhost:8082 jest tests/unit --testTimeout=15000",
    "test:integration": "cross-env ANALYSIS_API_URL=http://localhost:8082 jest tests/integration --testTimeout=15000",
    "test:coverage": "cross-env ANALYSIS_API_URL=http://localhost:8082 jest --coverage --testTimeout=15000",
    "health": "curl http://localhost:3001/health",
    "health:deep": "curl \"http://localhost:3001/health?deep=true\"",
    "health:analysis": "node scripts/check-status.js",
    "health:check": "node scripts/health-check.mjs",
    "health:monitor": "curl http://localhost:3001/api/monitoring/status",
    "health:dashboard": "curl http://localhost:3001/api/monitoring/dashboard",
    "test:health": "node test-health-comprehensive.js",
    "test:health:monitor": "node test-health-monitor.js",
    "test:health:all": "npm run test:health && npm run test:health:monitor",
    "metrics": "curl http://localhost:3001/metrics",
    "lint": "eslint src --ext .ts --fix --config config/eslint.config.js",
    "lint:check": "eslint src --ext .ts --config config/eslint.config.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean && npm run lint:check",
    "postinstall": "npx playwright install chromium --with-deps || PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium",
    "docker:build": "pwsh docker-build.ps1 prod",
    "docker:build:dev": "pwsh docker-build.ps1 dev",
    "docker:build:test": "pwsh docker-build.ps1 test",
    "docker:run": "docker compose up",
    "docker:run:detached": "docker compose up -d",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:test": "docker compose -f docker-compose.test.yml up",
    "docker:stop": "docker compose down && docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.test.yml down",
    "docker:clean": "pwsh docker-cleanup.ps1",
    "docker:size": "docker images | findstr accessibility-mw && docker system df",
    "analyze:bundle": "pwsh analyze-bundle.ps1",
    "bundle:monitor": "node scripts/bundle-monitor.js",
    "bundle:check": "node scripts/bundle-monitor.js",
    "bundle:limits": "node scripts/check-bundle-limits.js",
    "bundle:compare": "node scripts/compare-bundle-sizes.js",
    "bundle:watch": "bundlewatch --config .bundlewatch.config.json",
    "bundle:full": "npm run build && npm run bundle:monitor",
    "validate:project": "pwsh validate-project.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magodeveloper/accessibility-mw.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/magodeveloper/accessibility-mw/issues"
  },
  "homepage": "https://github.com/magodeveloper/accessibility-mw#readme",
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "accessibility-checker": "4.0.8",
    "axe-core": "4.10.3",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "helmet": "8.1.0",
    "ipaddr.js": "2.2.0",
    "js-yaml": "^4.1.0",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "playwright": "^1.55.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.40.0",
    "@typescript-eslint/parser": "8.40.0",
    "babel-jest": "^30.0.5",
    "bundlewatch": "^0.4.1",
    "cross-env": "^10.0.0",
    "eslint": "9.34.0",
    "jest": "30.0.5",
    "pino-pretty": "^13.1.1",
    "rimraf": "^6.0.1",
    "size-limit": "^11.2.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "size-limit": [
    {
      "name": "Server Bundle",
      "path": "dist/server.js",
      "limit": "5 MB",
      "ignore": [
        "playwright"
      ]
    },
    {
      "name": "Main Route Bundle",
      "path": "dist/routes/analyze.route.js",
      "limit": "2 MB"
    },
    {
      "name": "Utils Bundle",
      "path": "dist/utils/*.js",
      "limit": "1 MB"
    }
  ],
  "bundlewatch": {
    "files": [
      {
        "path": "./dist/**/*.js",
        "maxSize": "10mb",
        "compression": "gzip"
      },
      {
        "path": "./dist/server.js",
        "maxSize": "5mb",
        "compression": "gzip"
      }
    ],
    "ci": {
      "trackBranches": [
        "main",
        "develop"
      ],
      "compareWith": "main",
      "repoBranchBase": "origin/main"
    }
  }
}
