    "@types/node": "24.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "depcheck": "1.4.7",
    "nodemon": "3.1.10",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "rimraf": "^6.0.1"
  }
}